{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DynamicSecurityTester",
          "version": "1.0.0",
          "informationUri": "https://github.com/dynamictester",
          "rules": [
            {
              "id": "CWE-798",
              "name": "Security Vulnerability",
              "shortDescription": {
                "text": "Vulnerability (CWE-798)"
              },
              "fullDescription": {
                "text": "Hardcoded Credentials: Use of hard-coded credentials"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "owasp": null
              }
            },
            {
              "id": "CWE-321",
              "name": "Security Vulnerability",
              "shortDescription": {
                "text": "Vulnerability (CWE-321)"
              },
              "fullDescription": {
                "text": "Security vulnerability detected"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "owasp": null
              }
            },
            {
              "id": "CWE-79",
              "name": "Security Vulnerability",
              "shortDescription": {
                "text": "Vulnerability (CWE-79)"
              },
              "fullDescription": {
                "text": "Cross-site Scripting (XSS): Improper neutralization of input during web page generation"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "owasp": null
              }
            },
            {
              "id": "CWE-611: Improper Restriction of XML External Entity Reference",
              "name": "XXE",
              "shortDescription": {
                "text": "XXE (CWE-611: Improper Restriction of XML External Entity Reference)"
              },
              "fullDescription": {
                "text": "XXE detected"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "owasp": "A04:2017 - XML External Entities (XXE)"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-798",
          "level": "warning",
          "message": {
            "text": "[○ NOT EXPLOITABLE] Vulnerability at data/static/users.yml:150\nEndpoint: N/A\nPayload: N/A\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "data/static/users.yml"
                },
                "region": {
                  "startLine": 150,
                  "startColumn": 7
                }
              }
            }
          ],
          "properties": {
            "status": "TESTED_NOT_EXPLOITABLE",
            "endpoint": null,
            "proof": "None"
          }
        },
        {
          "ruleId": "CWE-321",
          "level": "warning",
          "message": {
            "text": "[○ NOT EXPLOITABLE] Vulnerability at frontend/src/app/app.guard.spec.ts:38\nEndpoint: N/A\nPayload: N/A\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/src/app/app.guard.spec.ts"
                },
                "region": {
                  "startLine": 38,
                  "startColumn": 36
                }
              }
            }
          ],
          "properties": {
            "status": "TESTED_NOT_EXPLOITABLE",
            "endpoint": null,
            "proof": "None"
          }
        },
        {
          "ruleId": "CWE-79",
          "level": "error",
          "message": {
            "text": "[✓ CONFIRMED] Vulnerability at frontend/src/hacking-instructor/index.ts:122\nEndpoint: http://localhost:4000/#/?query=<svg onload=alert(1)>\nPayload: <svg onload=alert(1)>\nPROOF: The payload <svg onload=alert(1)> was rendered and executed, confirming the XSS vulnerability."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/src/hacking-instructor/index.ts"
                },
                "region": {
                  "startLine": 122,
                  "startColumn": 3
                }
              }
            }
          ],
          "properties": {
            "status": "CONFIRMED",
            "endpoint": "http://localhost:4000/#/?query=<svg onload=alert(1)>",
            "payload": "<svg onload=alert(1)>",
            "proof": "The payload <svg onload=alert(1)> was rendered and executed, confirming the XSS vulnerability."
          }
        },
        {
          "ruleId": "CWE-611: Improper Restriction of XML External Entity Reference",
          "level": "warning",
          "message": {
            "text": "[○ NOT EXPLOITABLE] XXE at routes/fileUpload.ts:83\nEndpoint: http://localhost:4000/upload\nPayload: <?xml version=\"1.0\"?>\n<!DOCTYPE foo [<!ENTITY xxe SYSTEM \"file:///etc/passwd\">]>\n<data>&xxe;</data>\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "routes/fileUpload.ts"
                },
                "region": {
                  "startLine": 83,
                  "startColumn": 24
                }
              }
            }
          ],
          "properties": {
            "status": "TESTED_NOT_EXPLOITABLE",
            "endpoint": "http://localhost:4000/upload",
            "payload": "<?xml version=\"1.0\"?>\n<!DOCTYPE foo [<!ENTITY xxe SYSTEM \"file:///etc/passwd\">]>\n<data>&xxe;</data>",
            "proof": "Payloads processed without file content exfiltration or OOB callbacks"
          }
        }
      ]
    }
  ]
}
